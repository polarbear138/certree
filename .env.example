# Generate real secrets with: go run ./cmd/setup
# Never commit your .env file. Back up this master key separately from the DB.
CERTREE_MASTER_KEY=
CERTREE_ADMIN_USER=admin
CERTREE_ADMIN_PASSWORD=
CERTREE_ORIGIN=https://localhost:8443
CERTREE_ADDRESS=0.0.0.0:8080
CERTREE_DEV_HTTP=false
# Optional operator-managed PEM trust roots. Mount separately in Compose.
CERTREE_TRUST_BUNDLE=
